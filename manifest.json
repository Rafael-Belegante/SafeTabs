{
  "manifest_version": 3,
  "name": "SafeTabs",
  "short_name": "SafeTabs",
  "version": "1.0",
  "description": "Salve, organize, exporte, importe e reabra grupos de abas do navegador.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "action": {
    "default_title": "SafeTabs",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
